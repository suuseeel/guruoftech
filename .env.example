# SMTP settings for the contact form (app/api/contact/route.ts).
# Works with Hostinger's mailer out of the box — create a mailbox in
# hPanel > Emails first, then use its credentials here.
#
# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never put real credentials in this file.

# Hostinger SMTP host. Usually smtp.hostinger.com — check hPanel > Emails >
# Connect Apps & Devices > Manual configuration if yours differs.
SMTP_HOST=smtp.hostinger.com

# 465 = implicit TLS (SMTP_SECURE=true). 587 = STARTTLS (SMTP_SECURE=false).
SMTP_PORT=465
SMTP_SECURE=true

# Full mailbox address and its password, e.g. info@guruoftech.com
SMTP_USER=
SMTP_PASS=

# Optional: override the "From" address if it should differ from SMTP_USER
# (rarely needed — most SMTP providers reject a From that isn't SMTP_USER).
# MAIL_FROM=

# Optional: force every contact-form submission (both brands) to a single
# inbox, instead of each brand's own contactEmail in lib/brand.ts.
# CONTACT_TO_EMAIL=
